# ==================================================
# ARCHIVEX V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# Django Core Security
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Settings
DB_NAME=archivex
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CSRF & Security Headers
CSRF_TRUSTED_ORIGINS=https://example.com
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# HSTS Configuration (Only enable when HTTPS domain is verified)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Application Pricing & Defaults
PASS_SEMESTRE_PRIX_DEFAUT=2000
